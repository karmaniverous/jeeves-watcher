{
  "author": "Jason Williscroft",
  "bin": {
    "jeeves-watcher": "./dist/cli/jeeves-watcher/index.js"
  },
  "bugs": {
    "url": "https://github.com/karmaniverous/jeeves-watcher/issues"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.1.0",
    "@karmaniverous/jeeves": "0.11.0",
    "@karmaniverous/jeeves-watcher-core": "^0.6.2",
    "@karmaniverous/jeeves-watcher-sdk": "^0.4.1",
    "@karmaniverous/jsonmap": "^2.1.1",
    "@langchain/textsplitters": "*",
    "@parcel/watcher": "2.6.0",
    "@qdrant/js-client-rest": "^1.20.0",
    "ajv": "~8.20.0",
    "ajv-formats": "*",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "cosmiconfig": "*",
    "dayjs": "^1.11.23",
    "fastify": "^5",
    "handlebars": "^4.7.10",
    "hast-util-to-mdast": "^10.1.2",
    "ignore": "^7.0.14",
    "js-yaml": "^5.5.0",
    "mammoth": "^1.13.0",
    "mdast-util-from-adf": "^2.3.0",
    "mdast-util-to-markdown": "^2.2.3",
    "package-directory": "^8.2.0",
    "picomatch": "^4.0.7",
    "pino": "*",
    "pino-roll": "4.0.0",
    "radash": "^12.1.1",
    "rehype-parse": "^9.0.1",
    "unified": "^11.0.5",
    "unpdf": "^2.1.0",
    "uuid": "*",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "description": "Filesystem watcher that keeps a Qdrant vector store in sync with document changes",
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@rollup/plugin-alias": "^6.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^5.1.0",
    "cross-env": "^10.1.0",
    "fs-extra": "^11.4.1",
    "happy-dom": "^21.0.4",
    "knip": "^6.45.1",
    "release-it": "^21.1.2",
    "rollup": "^4.68.3",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.9.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-replace-text": "^4.2.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.22.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "config.schema.json"
  ],
  "homepage": "https://github.com/karmaniverous/jeeves-watcher#readme",
  "keywords": [
    "filesystem",
    "watcher",
    "qdrant",
    "vector-store",
    "embeddings",
    "semantic-search",
    "document-indexing",
    "rag",
    "langchain",
    "gemini",
    "typescript",
    "cli"
  ],
  "license": "BSD-3-Clause",
  "module": "dist/index.js",
  "name": "@karmaniverous/jeeves-watcher",
  "publishConfig": {
    "access": "public"
  },
  "release-it": {
    "git": {
      "changelog": "npx git-cliff --unreleased --strip header",
      "commitMessage": "chore: release @karmaniverous/jeeves-watcher v${version}",
      "requireBranch": "main",
      "tagName": "service/${version}"
    },
    "github": {
      "release": true,
      "releaseName": "${name.split('/').pop()}@${version}",
      "releaseNotes": "npx git-cliff --tag service/${version} --unreleased --strip header"
    },
    "hooks": {
      "before:init": [
        "node ../../scripts/check-core-range.mjs"
      ],
      "after:bump": [
        "npm install --package-lock-only --ignore-scripts",
        "git add ../../package-lock.json"
      ],
      "after:init": [
        "npm run lint",
        "npm run typecheck",
        "npm run test",
        "npm run build"
      ],
      "after:release": [
        "git switch -c release/service/${version}",
        "git push -u origin release/service/${version}",
        "git switch ${branchName}"
      ],
      "before:npm:release": [
        "npx git-cliff --tag service/${version} -o CHANGELOG.md",
        "git add -A"
      ]
    },
    "npm": {
      "publish": true
    }
  },
  "repository": {
    "directory": "packages/service",
    "type": "git",
    "url": "git+https://github.com/karmaniverous/jeeves-watcher.git"
  },
  "scripts": {
    "build": "npm run generate:schema && rimraf dist && cross-env NO_COLOR=1 rollup --config rollup.config.ts --configPlugin \"@rollup/plugin-typescript={paths:{}}\"",
    "changelog": "git-cliff -o CHANGELOG.md",
    "check:parcel": "tsx scripts/check-parcel-binary.ts",
    "diagrams": "cd diagrams && plantuml -tpng -o ../assets -r .",
    "facet:gate": "tsx scripts/facet-gate.ts",
    "index-check:cost": "tsx scripts/index-check-cost.ts",
    "generate:schema": "tsx src/config/generate-schema.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "release": "dotenvx run -f .env.local -- release-it",
    "release:pre": "dotenvx run -f .env.local -- release-it --no-git.requireBranch --github.preRelease --preRelease",
    "test": "vitest run --project unit && vitest run --project io && vitest run --project heavy",
    "wire:capture": "node scripts/capture-wire-0.20.0.mjs",
    "typecheck": "tsc"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "0.22.1"
}
