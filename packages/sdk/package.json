{
  "author": "Jason Williscroft",
  "bugs": {
    "url": "https://github.com/karmaniverous/jeeves-watcher/issues"
  },
  "dependencies": {
    "@karmaniverous/jeeves-watcher-core": "^0.4.0"
  },
  "description": "Typed TypeScript client for the jeeves-watcher HTTP API: search, scan, render, metadata, reindex, issues and source-document notify/delete",
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "release-it": "^21.1.1",
    "rollup": "^4.66.0",
    "rollup-plugin-dts": "^6.5.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/karmaniverous/jeeves-watcher#readme",
  "keywords": [
    "jeeves-watcher",
    "semantic-search",
    "qdrant",
    "sdk",
    "client"
  ],
  "license": "BSD-3-Clause",
  "name": "@karmaniverous/jeeves-watcher-sdk",
  "publishConfig": {
    "access": "public"
  },
  "release-it": {
    "git": {
      "changelog": "npx git-cliff --unreleased --strip header",
      "commitMessage": "chore: release @karmaniverous/jeeves-watcher-sdk v${version}",
      "requireBranch": "main",
      "tagName": "sdk/${version}"
    },
    "github": {
      "release": true,
      "releaseName": "${name.split('/').pop()}@${version}",
      "releaseNotes": "npx git-cliff --tag sdk/${version} --unreleased --strip header"
    },
    "hooks": {
      "after:bump": [
        "npm install --package-lock-only --ignore-scripts",
        "git add ../../package-lock.json"
      ],
      "after:init": [
        "npm run lint",
        "npm run typecheck",
        "npm run test",
        "npm run build"
      ],
      "after:release": [
        "git switch -c release/sdk/${version}",
        "git push -u origin release/sdk/${version}",
        "git switch ${branchName}"
      ],
      "before:npm:release": [
        "npx git-cliff --tag sdk/${version} -o CHANGELOG.md",
        "git add -A"
      ]
    },
    "npm": {
      "publish": true
    }
  },
  "repository": {
    "directory": "packages/sdk",
    "type": "git",
    "url": "git+https://github.com/karmaniverous/jeeves-watcher.git"
  },
  "scripts": {
    "build": "cross-env NO_COLOR=1 rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "changelog": "git-cliff -o CHANGELOG.md",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prebuild": "npx rimraf dist",
    "release": "dotenvx run -f .env.local -- release-it",
    "release:pre": "dotenvx run -f .env.local -- release-it --no-git.requireBranch --github.preRelease --preRelease",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "0.2.0"
}
