{
  "openapi": "3.1.0",
  "info": {
    "title": "jeeves-watcher",
    "version": "0.4.0",
    "description": "HTTP API of the jeeves-watcher service: the routes in its endpoint catalog (WATCHER_CATALOG). Every route except GET /status requires the API key as a bearer token when api.apiKey is configured."
  },
  "paths": {
    "/status": {
      "get": {
        "operationId": "status",
        "description": "Get watcher service health, version, and uptime.",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "uptime": {
                      "type": "number"
                    },
                    "status": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "healthy"
                        },
                        {
                          "type": "string",
                          "const": "degraded"
                        },
                        {
                          "type": "string",
                          "const": "unhealthy"
                        }
                      ]
                    },
                    "health": {
                      "type": "object",
                      "properties": {
                        "collection": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "pointCount": {
                              "type": "number"
                            },
                            "dimensions": {
                              "type": "number"
                            }
                          },
                          "required": [
                            "name",
                            "pointCount",
                            "dimensions"
                          ],
                          "additionalProperties": false
                        },
                        "reindex": {
                          "type": "object",
                          "properties": {
                            "active": {
                              "type": "boolean"
                            },
                            "scope": {
                              "type": "string"
                            },
                            "startedAt": {
                              "type": "string"
                            },
                            "filesProcessed": {
                              "type": "number"
                            },
                            "totalFiles": {
                              "type": "number"
                            }
                          },
                          "required": [
                            "active"
                          ],
                          "additionalProperties": false
                        },
                        "initialScan": {
                          "type": "object",
                          "properties": {
                            "active": {
                              "type": "boolean"
                            },
                            "filesMatched": {
                              "type": "number"
                            },
                            "filesEnqueued": {
                              "type": "number"
                            },
                            "startedAt": {
                              "type": "string"
                            },
                            "completedAt": {
                              "type": "string"
                            },
                            "durationMs": {
                              "type": "number"
                            }
                          },
                          "required": [
                            "active"
                          ],
                          "additionalProperties": false
                        },
                        "error": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "name",
                    "version",
                    "uptime",
                    "status",
                    "health"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/config": {
      "get": {
        "operationId": "config",
        "description": "Query watcher running configuration. Optional JSONPath filter.",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "path",
            "schema": {
              "type": "string",
              "description": "JSONPath expression (optional)"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "result": {
                          "type": "array",
                          "items": {}
                        },
                        "count": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "result",
                        "count"
                      ],
                      "additionalProperties": {}
                    },
                    {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": {}
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/config/apply": {
      "post": {
        "operationId": "configApply",
        "description": "Apply a config patch to the running watcher service.",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "patch": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {},
                    "description": "Config patch to apply"
                  },
                  "replace": {
                    "type": "boolean",
                    "description": "Replace the whole config instead of merging"
                  }
                },
                "required": [
                  "patch"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "applied": {
                      "type": "boolean",
                      "const": true
                    },
                    "config": {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": {}
                    },
                    "warning": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "applied",
                    "config"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/render": {
      "post": {
        "operationId": "render",
        "description": "Render a document (file path, or source reference retrieved through its callback) through the template pipeline.",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Absolute or watched file path."
                  },
                  "source": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{1,31}:\\/\\/\\S{1,512}$",
                    "description": "Source document reference: <name>://<id>."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "renderAs": {
                      "type": "string"
                    },
                    "content": {
                      "type": "string"
                    },
                    "rules": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "metadata": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "renderAs",
                    "content",
                    "rules",
                    "metadata"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "post": {
        "operationId": "search",
        "description": "Semantic search over indexed documents. Supports Qdrant filters.",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Search query text."
                  },
                  "limit": {
                    "description": "Max results (default 10).",
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "offset": {
                    "description": "Number of results to skip for pagination.",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "filter": {
                    "description": "Qdrant filter object.",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "query"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "score": {
                        "type": "number"
                      },
                      "payload": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      }
                    },
                    "required": [
                      "id",
                      "score",
                      "payload"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/scan": {
      "post": {
        "operationId": "scan",
        "description": "Filter-only point query without vector search. Returns metadata for points matching a Qdrant filter.",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "filter": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {},
                    "description": "Qdrant filter object (required)."
                  },
                  "limit": {
                    "description": "Page size (default 100, max 1000).",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "cursor": {
                    "description": "Opaque cursor from previous response for pagination.",
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "fields": {
                    "description": "Payload fields to return (projection).",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "countOnly": {
                    "description": "If true, return { count } instead of points.",
                    "type": "boolean"
                  }
                },
                "required": [
                  "filter"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "points": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "payload": {
                                "type": "object",
                                "propertyNames": {
                                  "type": "string"
                                },
                                "additionalProperties": {}
                              }
                            },
                            "required": [
                              "id",
                              "payload"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "cursor": {
                          "type": [
                            "string",
                            "number",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "points",
                        "cursor"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "count"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/vcs/show": {
      "get": {
        "operationId": "vcsShow",
        "description": "Retrieve file content at a specific version. The reply is the raw file content; its content-type follows the file extension.",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "path",
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "File path to retrieve."
            },
            "required": true,
            "description": "File path to retrieve."
          },
          {
            "in": "query",
            "name": "commit",
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Version identifier."
            },
            "required": true,
            "description": "Version identifier."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": {}
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
