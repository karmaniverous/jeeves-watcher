{
  "author": "Jason Williscroft",
  "bugs": {
    "url": "https://github.com/karmaniverous/jeeves-watcher/issues"
  },
  "dependencies": {
    "@karmaniverous/jeeves": "0.8.0-6",
    "@karmaniverous/jsonmap": "^2.1.1",
    "zod": "^4.6.7"
  },
  "description": "Shared Zod schemas, types, defaults and constants for jeeves-watcher, its SDK and its OpenClaw plugin",
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "release-it": "^21.1.1",
    "rollup": "^4.66.0",
    "rollup-plugin-dts": "^6.5.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "dist",
    "openapi.json"
  ],
  "homepage": "https://github.com/karmaniverous/jeeves-watcher#readme",
  "license": "BSD-3-Clause",
  "name": "@karmaniverous/jeeves-watcher-core",
  "publishConfig": {
    "access": "public"
  },
  "release-it": {
    "git": {
      "changelog": "npx git-cliff --unreleased --strip header",
      "commitMessage": "chore: release @karmaniverous/jeeves-watcher-core v${version}",
      "requireBranch": "main",
      "tagName": "core/${version}"
    },
    "github": {
      "release": true,
      "releaseName": "${name.split('/').pop()}@${version}",
      "releaseNotes": "npx git-cliff --tag core/${version} --unreleased --strip header"
    },
    "hooks": {
      "after:bump": [
        "npm install --package-lock-only --ignore-scripts",
        "npm run openapi",
        "git add ../../package-lock.json openapi.json"
      ],
      "after:init": [
        "npm run lint",
        "npm run typecheck",
        "npm run test",
        "npm run build"
      ],
      "after:release": [
        "git switch -c release/core/${version}",
        "git push -u origin release/core/${version}",
        "git switch ${branchName}"
      ],
      "before:npm:release": [
        "npx git-cliff --tag core/${version} -o CHANGELOG.md",
        "git add -A"
      ]
    },
    "npm": {
      "publish": true
    }
  },
  "repository": {
    "directory": "packages/core",
    "type": "git",
    "url": "git+https://github.com/karmaniverous/jeeves-watcher.git"
  },
  "scripts": {
    "build": "cross-env NO_COLOR=1 rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "changelog": "git-cliff -o CHANGELOG.md",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "openapi": "tsx scripts/write-openapi.ts",
    "prebuild": "npx rimraf dist",
    "release": "dotenvx run -f .env.local -- release-it",
    "release:pre": "dotenvx run -f .env.local -- release-it --no-git.requireBranch --github.preRelease --preRelease",
    "skill": "tsx scripts/generate-skill.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "0.5.0-0"
}
